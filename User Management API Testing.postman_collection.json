    {
      "name": "Get All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code should be 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst responseData = pm.response.json();\r\n\r\npm.test(\"Response should contain users\",function(){\r\n    pm.expect(responseData).to.have.property(\"users\");\r\n});\r\n\r\npm.test(\"First users id should be 1\",function(){\r\n    pm.expect(responseData.users[0].id).to.eql(1);\r\n});\r\n\r\npm.test(\"First users name should be Emily\",function(){\r\n    pm.expect(responseData.users[0].firstName).to.eql(\"Emily\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/users",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
