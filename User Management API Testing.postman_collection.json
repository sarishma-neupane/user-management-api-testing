              "pm.test(\"Status code should be 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst responseData = pm.response.json();\r\n\r\npm.test(\"User should be marked as deleted\", function () {\r\n    pm.expect(responseData.isDeleted).to.eql(true);\r\n});\r\n\r\npm.test(\"Deletion date should be present\", function () {\r\n    pm.expect(responseData).to.have.property(\"deletedOn\");\r\n});\r\n\r\npm.test(\"Deleted user ID should be 1\", function () {\r\n    pm.expect(responseData.id).to.eql(1);\r\n});"
