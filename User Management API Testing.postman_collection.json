      "name": "Create New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code should be 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst responseData = pm.response.json();\r\n\r\npm.test(\"Response should contain an ID\", function () {\r\n    pm.expect(responseData).to.have.property(\"id\");\r\n});\r\n\r\npm.test(\"First name should be Harsh\", function () {\r\n    pm.expect(responseData.firstName).to.eql(\"Harsh\");\r\n});\r\n\r\npm.test(\"Last name should be Manohar\", function () {\r\n    pm.expect(responseData.lastName).to.eql(\"Manohar\");\r\n});\r\n\r\npm.test(\"Age should be 22\", function () {\r\n    pm.expect(responseData.age).to.eql(22);\r\n});"
            ]
          }
        }
      ],
